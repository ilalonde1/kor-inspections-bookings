@page
@model Kor.Inspections.App.Pages.IndexModel

@section Styles {
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css"
          integrity="sha384-RkASv+6KfBMW9eknReJIJ6b3UnjKOKC5bOUaNgIY778NFbQ8MtWq9Lr/khUgqtTt"
          crossorigin="anonymous"
          referrerpolicy="no-referrer">
}

@{
    ViewData["Title"] = "Book a Field Review";
    ViewData["InspectorMode"] = "false";

    var (minDate, maxDate) = Model.AllowedDates;

    var step2Locked = Model.SelectedContactId == null;
}

<h2>Book a Field Review</h2>

<p>
    Please complete the form below to request a field review.
    Bookings for the following day close at 2:00 p.m. Pacific.
    If a booking is required after this time for the next day please contact Tyler directly at 604-816-3327 to check for availability.
</p>

<form method="post" asp-antiforgery="true">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="SelectedContactId" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Honeypot -->
    <div style="display:none">
        <input name="CompanyFax" tabindex="-1" autocomplete="off" />
    </div>

    <!-- ============================= -->
    <!-- STEP 1 -->
    <!-- ============================= -->

    <fieldset class="phase-box">
        <legend>
            <span class="step-pill">Step 1</span>
            Find Project Contacts
        </legend>

        <div class="step-helper">
            Enter the Kor Job Number and contact email to manage project contacts.
        </div>

        <div class="form-group">
            <label asp-for="ProjectNumber"></label>
            <div class="project-search-row">
                <input asp-for="ProjectNumber" class="form-control" />
                <button type="button" id="projectSearchBtn" class="btn btn-outline-primary">
                    Search
                </button>
            </div>
            <small class="helper-text-muted">
                Enter a project number or project name, then click Search and select a result.
            </small>
            <div id="projectSearchStatus" class="helper-text-muted project-search-status" aria-live="polite"></div>
            <span asp-validation-for="ProjectNumber" class="text-danger"></span>
            <div id="projectSuggestions" class="project-suggestions" hidden></div>
        </div>

        <div class="form-group">
            <label asp-for="ContactEmail"></label>
            <input asp-for="ContactEmail" class="form-control" />
            <span asp-validation-for="ContactEmail" class="text-danger"></span>

            <div id="projectEmailVerificationBox" class="project-email-verify-box" hidden>
                <div class="helper-text-muted">
                    Verify this email with a one-time code to access project contacts.
                </div>
                <div class="project-email-verify-row">
                     <button type="button" id="sendProjectEmailCodeBtn" class="btn btn-outline-primary">
                         Send Code
                     </button>
                     <label for="projectEmailCodeInput">Verification code</label>
                     <input id="projectEmailCodeInput"
                            class="form-control project-email-code-input"
                            inputmode="numeric"
                            maxlength="6"
                            placeholder="Enter 6-digit code" />
                     <button type="button" id="verifyProjectEmailCodeBtn" class="btn btn-primary">
                         Verify
                    </button>
                </div>
                <div id="projectEmailVerificationStatus"
                     class="helper-text-muted project-email-verify-status"
                     aria-live="polite"></div>
            </div>

            <button type="button"
                    id="openContactModalBtn"
                    class="btn btn-outline-primary mt-2">
                Assign Contact and View Current Inspections
            </button>
        </div>
    </fieldset>


    <!-- ============================= -->
    <!-- STEP 2 -->
    <!-- ============================= -->

    <div class="step2-wrapper @(step2Locked ? "step2-locked" : "")">

        @if (step2Locked)
        {
            <div class="step-lock-overlay">
                Complete Step 1 to unlock booking
            </div>
        }

        <fieldset class="phase-box mt-4"
                  id="step2Fieldset"
                  @(step2Locked ? "disabled" : "")>

            <legend>
                <span class="step-pill">Step 2</span>
                Request Field Review
            </legend>

            <div class="step-helper">
                Confirm contact details and choose your preferred inspection time.
            </div>

            <div class="form-group">
                <label asp-for="ProjectAddress"></label>
                <input asp-for="ProjectAddress" class="form-control" />
                <span asp-validation-for="ProjectAddress" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ContactName"></label>
                <input asp-for="ContactName" class="form-control" />
                <span asp-validation-for="ContactName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ContactPhone"></label>
                <input asp-for="ContactPhone" type="tel" class="form-control" />
                <span asp-validation-for="ContactPhone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RequestedDate"></label>

                <input asp-for="RequestedDate"
                       id="requestedDate"
                       type="text"
                       value="@Model.RequestedDate?.ToString("yyyy-MM-dd")"
                       autocomplete="off"
                       class="form-control"
                       data-mindate="@minDate.ToString("yyyy-MM-dd")"
                       data-maxdate="@maxDate.ToString("yyyy-MM-dd")" />

                <span asp-validation-for="RequestedDate" class="text-danger"></span>
            </div>

            <button type="submit"
                    asp-page-handler="RefreshTimes"
                    formnovalidate
                    id="autoRefreshTimesBtn"
                    style="display:none;">
            </button>

            <div class="form-group">
                <label asp-for="RequestedTime"></label>
                <select asp-for="RequestedTime" class="form-control">
                    <option value="">-- Select a time --</option>
                    <option value="AM">Anytime AM</option>
                    <option value="PM">Anytime PM</option>

                    @foreach (var t in Model.AvailableTimes)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <span asp-validation-for="RequestedTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Comments"></label>
                <textarea asp-for="Comments" class="form-control comments-textarea" placeholder="Specify floor and element details"></textarea>
                <span asp-validation-for="Comments" class="text-danger"></span>
            </div>

            <button type="submit" asp-page-handler="Book" class="btn btn-primary">
                Request Field Review
            </button>
        </fieldset>

    </div>

</form>



<!-- ============================= -->
<!-- CONTACT MODAL -->
<!-- ============================= -->

<div id="contactModal" class="kor-modal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="contactModalTitle">
    <div class="kor-modal-content">

        <h3 id="contactModalTitle" class="contact-modal-title">Project Contacts</h3>
        <p class="contact-modal-subtitle">Choose an existing contact or create a new one to use for this booking. Selecting a contact will automatically populate the request form.</p>

        <div class="modal-workspace">
            <section class="modal-contact-panel">
                <div class="contact-section">
                    <h4 class="contact-section-title">Project Contacts</h4>
                    <div id="contactLookupArea" class="contact-list"></div>
                </div>

                <div class="contact-section contact-form-panel">
                    <h4 id="contactFormTitle" class="contact-section-title">Add Contact</h4>
                    <input type="hidden" id="modalEditContactId" />

                    <div class="contact-form-grid">
                        <div class="form-group contact-form-field contact-form-half">
                            <label>Name</label>
                            <input id="modalContactName" class="form-control" />
                        </div>

                        <div class="form-group contact-form-field contact-form-half">
                            <label>Phone</label>
                            <input id="modalContactPhone" class="form-control" />
                        </div>

                        <div class="form-group contact-form-field contact-form-full">
                            <label>Site Address</label>
                            <input id="modalContactAddress" class="form-control" />
                        </div>

                        <div class="form-group contact-form-field contact-form-full">
                            <label>Email</label>
                            <input id="modalContactEmail" class="form-control" />
                        </div>
                    </div>

                    <div class="contact-form-actions">
                        <button id="saveContactBtn" type="button" class="btn btn-primary mt-2">
                            Save Contact
                        </button>
                        <button id="cancelEditBtn" type="button" class="btn btn-secondary mt-2" style="display:none;">
                            Cancel Edit
                        </button>
                    </div>
                </div>
            </section>

            <section class="modal-inspections-panel">
                <div class="contact-section">
                    <div class="inspection-header-row">
                        <h4 id="inspectionListTitle" class="contact-section-title">Active Inspections</h4>
                        <span id="inspectionCountLabel" class="helper-text-muted"></span>
                        <div class="inspection-filter-toggle">
                            <button type="button" id="inspectionFilterActiveBtn" class="btn btn-sm btn-secondary active">Active</button>
                            <button type="button" id="inspectionFilterAllBtn" class="btn btn-sm btn-secondary">All</button>
                        </div>
                    </div>
                    <div id="inspectionLookupArea" class="contact-list inspection-list"></div>
                </div>
            </section>

            <aside id="inspectionDetailsPanel" class="inspection-details-panel" aria-hidden="true">
                <div class="inspection-details-head">
                    <h4 class="contact-section-title">Inspection Details</h4>
                    <button type="button" id="closeInspectionDetailsBtn" class="btn btn-sm btn-secondary">Close</button>
                </div>
                <div id="inspectionDetailsEmpty" class="helper-text-muted">Select an inspection to view details.</div>
                <div id="inspectionDetailsBody" class="inspection-details-body" hidden>
                    <div class="inspection-detail-row"><strong>Status:</strong> <span id="inspectionDetailStatus"></span></div>
                    <div class="inspection-detail-row"><strong>Start:</strong> <span id="inspectionDetailStart"></span></div>
                    <div class="inspection-detail-row"><strong>End:</strong> <span id="inspectionDetailEnd"></span></div>
                    <div class="inspection-detail-row"><strong>Address:</strong> <span id="inspectionDetailAddress"></span></div>
                    <div class="inspection-detail-row"><strong>Comments:</strong> <span id="inspectionDetailComments"></span></div>
                    <div class="inspection-detail-actions">
                        <button type="button" id="cancelInspectionBtn" class="btn btn-danger">Cancel Booking</button>
                    </div>
                </div>
            </aside>
        </div>

        <div class="contact-form-actions">
            <button id="closeModalBtn" class="btn btn-secondary mt-2">
                Close
            </button>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"
            integrity="sha384-5JqMv4L/Xa0hfvtF06qboNdhvuYXUku9ZrhZh3bSk8VXF0A/RuSLHpLsSV9Zqhl6"
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
    <script src="~/js/booking-page.js" asp-append-version="true"></script>
}
